---
// What a concept's frontmatter says about it, above its body: the trust
// label in the words ktl-curator and ktl-docent use, the events behind it,
// its sources, and its typed relations in both directions. The label comes
// from knowledge-report.sh, so the site never derives it a second way.
const { concept } = Astro.props;

const actor = (by: string) => {
  const [kind, ...rest] = by.split(":");
  const who = rest.join(":") || by;
  if (kind === "human") return { who, kind: "a person" };
  if (kind === "process") return { who, kind: "automation" };
  return { who: by, kind: "" };
};
const day = (at: string) => at.slice(0, 10);
// GlossaryTerm reads "Glossary term".
const words = (camel: string) =>
  camel.replace(/([a-z])([A-Z])/g, "$1 $2").replace(/ ([A-Z])/g, (_, c: string) => " " + c.toLowerCase());
// A definition is plain text with Markdown code spans; escape it, then set the spans.
const inline = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
---

<section class="ktl-concept" aria-label="About this concept" data-pagefind-ignore>
  <p class="ktl-concept__lede">
    <span class={`ktl-label ktl-label--${concept.tone}`}>{concept.label}</span>
    <span class="ktl-concept__type">{words(concept.type)}</span>
    {concept.tags.map((tag: string) => <span class="ktl-concept__tag">{tag}</span>)}
  </p>

  {concept.definition && (
    <p class="ktl-concept__definition">
      <strong>Definition.</strong> <span set:html={inline(concept.definition)} />
    </p>
  )}

  <dl class="ktl-concept__facts">
    {concept.generated && (
      <>
        <dt>Written</dt>
        <dd>
          {day(concept.generated.at)} by <code>{actor(concept.generated.by).who}</code>
          {actor(concept.generated.by).kind && <span class="ktl-concept__kind"> ({actor(concept.generated.by).kind})</span>}
        </dd>
      </>
    )}
    <dt>Checked</dt>
    <dd>
      {concept.verified.length === 0 ? (
        "never"
      ) : (
        <ul>
          {concept.verified.map((event: { by: string; at: string; note?: string }) => (
            <li>
              {day(event.at)} by <code>{actor(event.by).who}</code>
              {actor(event.by).kind && <span class="ktl-concept__kind"> ({actor(event.by).kind})</span>}
              {event.note && <span>: {event.note}</span>}
            </li>
          ))}
        </ul>
      )}
    </dd>
    {concept.reviewBy && (
      <>
        <dt>Review by</dt>
        <dd>{concept.reviewBy}</dd>
      </>
    )}
    {concept.sources.length > 0 && (
      <>
        <dt>Sources</dt>
        <dd>
          <ul>
            {concept.sources.map((s: { text: string; href: string }) => (
              <li><a href={s.href}><code>{s.text}</code></a></li>
            ))}
          </ul>
        </dd>
      </>
    )}
    {concept.relations.map((rel: { name: string; targets: { text: string; href: string }[] }) => (
      <>
        <dt>{rel.name}</dt>
        <dd>
          <ul>
            {rel.targets.map((t) => (
              <li><a href={t.href}>{t.text}</a></li>
            ))}
          </ul>
        </dd>
      </>
    ))}
    {concept.incoming.length > 0 && (
      <>
        <dt>Pointed to by</dt>
        <dd>
          <ul>
            {concept.incoming.map((i: { name: string; from: { text: string; href: string } }) => (
              <li><a href={i.from.href}>{i.from.text}</a> <span class="ktl-concept__kind">({i.name})</span></li>
            ))}
          </ul>
        </dd>
      </>
    )}
    <dt>IRI</dt>
    <dd><code>{concept.iri}</code></dd>
    <dt>Files</dt>
    <dd class="ktl-concept__files">
      <a href={concept.files.markdown}>Markdown</a>
      <a href={concept.files.jsonld}>JSON-LD</a>
      <a href={concept.files.github}>Source on GitHub</a>
    </dd>
  </dl>
</section>
