    "quality_profile": "showcase",
    "locale": "en",
    "translations": {
      "diagram.description.workflow": "A release of the top domain starts the build, which does not run an agent. It resolves, verifies, registers and exports, loads one named graph per bundle, gates the links between bundles, and swaps by two renames. A failed check stops the job, and the old workspace stays. A member that cannot be fetched is held at its last good state. Readers use SPARQL or MCP."
    },
    "repository": {
      "url": "https://github.com/noelmcloughlin/knowledge-trust-ladder.git",
      "provider": "github",
      "link_mode": "web",
      "revision": "2df7b5d1a6ca43c340ea4d7efc0a94af2bdcb06a"
    },
