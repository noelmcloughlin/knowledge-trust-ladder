  "meta": {
    "title": "How the context workspace stays current",
    "output": ".assets/companions/ktl-context-workspace.html",
    "quality_profile": "showcase",
    "locale": "en",
    "translations": {
      "diagram.description.workflow": "A published release starts the refresh job, which runs no agent. It resolves the members into a lock, verifies each file, builds one named graph per bundle, gates the links between bundles and swaps the snapshot in whole. A failed check or gate stops the job; the old snapshot stays. A member whose file cannot be fetched is held at its last good state. Readers query it over SPARQL or MCP."
    },
    "repository": {
      "url": "https://github.com/noelmcloughlin/knowledge-trust-ladder.git",
      "provider": "github",
      "link_mode": "web",
      "revision": "2ff9f0d2850a922e5861b0f841a9e6399db9cbc7"
    },
    "legend": {
      "entries": {
        "cloud": { "label": "where releases are published" },
        "security": { "label": "built and gated by a script, no agent" },
        "database": { "label": "what the build writes" },
        "frontend": { "label": "who reads it" }
      }
    }
  },
